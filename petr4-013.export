pinned: "petr4.0.1.2"
package "petr4" {
  opam-version: "2.0"
  version: "0.1.2"
  synopsis: "Petr4: Formal Semantics for the P4 Programming Language"
  maintainer: "jnfoster@cs.cornell.edu"
  authors: "Nate Foster <jnfoster@cs.cornell.edu>"
  license: "Apache-2.0"
  homepage: "https://github.com/cornell-netlab/petr4"
  bug-reports: "https://github.com/cornell-netlab/petr4/issues"
  depends: [
    "alcotest"
    "bignum"
    "ocaml" {>= "4.12.0"}
    "dune" {>= "1.2"}
    "cstruct"
    "cstruct-sexp"
    "menhir" {<= "20211128"}
    "ANSITerminal"
    "core" {>= "0.15.0"}
    "ppx_deriving_yojson"
    "ppx_jane" {>= "0.15.0"}
    "ppx_js_style" {>= "0.14444.0"}
    "yojson" {>= "1.7.0"}
    "js_of_ocaml"
    "js_of_ocaml-lwt"
    "js_of_ocaml-ppx"
    "p4pp" {>= "0.1.12"}
    "odoc"
    "ppx_expect" {>= "0.15.0"}
    "pp" {>= "1.0.1"}
    "zarith" {= "1.12"}
  ]
  build: [
    ["dune" "subst"] {pinned}
    ["dune" "build" "-p" name "-j" jobs]
    ["dune" "runtest" "-p" name "-j" jobs] {with-test}
    ["dune" "build" "@doc" "-p" name "-j" jobs] {with-doc}
  ]
  dev-repo: "git+https://github.com/cornell-netlab/petr4/"
  url {
    src: "git+file:///home/pacokwon/workspace/petr4#HEAD"
  }
}
